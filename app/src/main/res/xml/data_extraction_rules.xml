<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="countdown_timer_database" />
        <include domain="sharedpref" path="daycount_app_prefs.xml" />
        <exclude domain="sharedpref" path="daycount_widget_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="countdown_timer_database" />
        <include domain="sharedpref" path="daycount_app_prefs.xml" />
        <exclude domain="sharedpref" path="daycount_widget_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
